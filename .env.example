# =============================================================================
# SMARTSCHOOL - CONFIGURATION ENVIRONNEMENT
# =============================================================================
# Date: 2026-01-24
# Version: 1.0
# Environnement: PRODUCTION / STAGING / DEVELOPMENT
# =============================================================================
# IMPORTANT:
# - Ce fichier contient des valeurs par défaut pour le DÉVELOPPEMENT UNIQUEMENT
# - En PRODUCTION, remplacer TOUTES les valeurs CHANGEME par des valeurs sécurisées
# - NE JAMAIS commiter ce fichier dans Git (.gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONNEMENT
# -----------------------------------------------------------------------------
# Valeurs possibles: development | production
NODE_ENV=development

# Valeurs possibles: staging | production | development
APP_ENV=development

# -----------------------------------------------------------------------------
# BASE DE DONNÉES (PostgreSQL)
# -----------------------------------------------------------------------------
DB_USER=smartschool_user
DB_PASSWORD=CHANGEME_SECURE_PASSWORD_MIN_16_CHARS
DB_NAME=smartschool_db
DB_PORT=5432
DB_HOST=smartschool-db

# URL complète Prisma (auto-générée, NE PAS modifier manuellement)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# -----------------------------------------------------------------------------
# BACKEND (API NestJS)
# -----------------------------------------------------------------------------
# Port sur lequel le backend écoute
PORT=3010

# Port exposé pour Docker (généralement identique à PORT)
BACKEND_PORT=3010

# Secret JWT (MINIMUM 32 caractères, générer avec: openssl rand -base64 32)
# ⚠️ CRITIQUE: Changer en production !
JWT_SECRET=CHANGEME_GENERATE_SECURE_JWT_SECRET_HERE_MINIMUM_32_CHARACTERS

# -----------------------------------------------------------------------------
# FRONTEND (REACT + VITE)
# -----------------------------------------------------------------------------
# Port sur lequel le frontend écoute
UI_PORT=3003

# Port sur lequel le frontend support (interface technique) écoute
SUPPORT_PORT=3004

# URL de l'API backend pour le frontend
# Développement: http://localhost:3010
# Production: https://api.votre-domaine.com
VITE_API_URL=http://localhost:3010

# -----------------------------------------------------------------------------
# CORS (URLs autorisées pour les requêtes cross-origin)
# -----------------------------------------------------------------------------
# Séparer les URLs multiples par des virgules (sans espaces)
# Développement:
FRONTEND_URL=http://localhost:3003,http://localhost:5173

# Production (exemple):
# FRONTEND_URL=https://smartschool.votre-domaine.com,https://www.votre-domaine.com

# URL Ngrok (DÉVELOPPEMENT UNIQUEMENT)
# Décommenter et remplir si vous utilisez ngrok pour les tests
# ⚠️ Cette URL sera autorisée UNIQUEMENT si NODE_ENV=development
# NGROK_URL=https://votre-url-unique.ngrok-free.dev

# -----------------------------------------------------------------------------
# STOCKAGE CLOUD (Cloudflare R2 / S3 compatible)
# -----------------------------------------------------------------------------
# Laisser vide pour utiliser le stockage local (uploads/)
# Remplir uniquement si vous utilisez Cloudflare R2 ou AWS S3

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=smartschool-files
R2_PUBLIC_URL=

# Alternative AWS S3 (si vous n'utilisez pas R2):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# S3_BUCKET_NAME=

# -----------------------------------------------------------------------------
# SÉCURITÉ & RATE LIMITING
# -----------------------------------------------------------------------------
# Nombre maximum de tentatives de connexion par IP (fenêtre de 15 minutes)
RATE_LIMIT_AUTH_MAX=20

# Nombre maximum de requêtes API générales par IP (fenêtre de 1 minute)
RATE_LIMIT_API_MAX=1000

# -----------------------------------------------------------------------------
# DOCKER & DÉPLOIEMENT
# -----------------------------------------------------------------------------
# Chemin de persistance des données (utilisé par docker-compose.yml)
# CasaOS: /DATA/AppData/smartschool/${APP_ENV}
# Autre: /var/lib/smartschool/${APP_ENV}
DATA_PATH=/DATA/AppData/smartschool/${APP_ENV}

# -----------------------------------------------------------------------------
# EMAIL (Optionnel - pour notifications)
# -----------------------------------------------------------------------------
# Laisser vide si vous n'utilisez pas les notifications par email

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notifications@votre-domaine.com
# SMTP_PASSWORD=
# SMTP_FROM=SmartSchool <noreply@votre-domaine.com>

# -----------------------------------------------------------------------------
# LOGS & MONITORING (Optionnel)
# -----------------------------------------------------------------------------
# Niveau de logs: error | warn | info | debug | verbose
LOG_LEVEL=info

# Activer les logs détaillés Prisma (true | false)
PRISMA_LOG=false

# -----------------------------------------------------------------------------
# FONCTIONNALITÉS (Optionnel)
# -----------------------------------------------------------------------------
# Activer/désactiver certaines fonctionnalités

# Activer les WebSockets (notifications temps réel)
ENABLE_WEBSOCKETS=true

# Activer le module de génération de bulletins PDF
ENABLE_PDF_GENERATION=true

# Activer le module de stockage cloud (R2/S3)
ENABLE_CLOUD_STORAGE=false

# -----------------------------------------------------------------------------
# NOTES & DOCUMENTATION
# -----------------------------------------------------------------------------
# 1. Sécurité:
#    - NE JAMAIS commiter ce fichier dans Git
#    - Utiliser des mots de passe forts (32+ caractères)
#    - Régénérer JWT_SECRET en production avec: openssl rand -base64 32
#    - Changer TOUTES les valeurs CHANGEME avant déploiement
#
# 2. Développement:
#    - Copier ce fichier en `.env.local` pour vos tests locaux
#    - Les valeurs par défaut fonctionnent pour le développement local
#
# 3. Production:
#    - Utiliser un gestionnaire de secrets (Vault, AWS Secrets Manager, etc.)
#    - Configurer des backups automatiques de la base de données
#    - Activer HTTPS et configurer les certificats SSL
#
# 4. Nouvelles variables:
#    - Documenter toute nouvelle variable ajoutée ici
#    - Ajouter la variable correspondante dans .env.example
#    - Mettre à jour la documentation (README.md)
#
# =============================================================================
# FIN DE CONFIGURATION
# =============================================================================
